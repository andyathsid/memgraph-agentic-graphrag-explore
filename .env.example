# Copy this file to .env and replace secrets before running the project.

# Use UTF-8 for Aegra child processes on Windows.
PYTHONUTF8="1"

# Aegra server.
AEGRA_CONFIG="aegra.json"
AUTH_TYPE="noop"
HOST="0.0.0.0"
PORT="2026"
RUN_MIGRATIONS_ON_STARTUP="true"

# PostgreSQL used by Aegra. Keep these values aligned with docker-compose.yml.
POSTGRES_USER="memgraph_agentic_graphrag_explore"
POSTGRES_PASSWORD="memgraph_agentic_graphrag_explore_secret"
POSTGRES_DB="memgraph_agentic_graphrag_explore"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
DB_ECHO_LOG="false"

# Local development runs jobs in-process. Docker Compose enables Redis.
REDIS_BROKER_ENABLED="false"

# Source database used only by the migration command.
NEO4J_URI="bolt://localhost:7687"
NEO4J_DATABASE="neo4j"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="change-me"

# Memgraph has authentication disabled in the local Compose stack.
MEMGRAPH_URI="bolt://localhost:7688"
MEMGRAPH_DATABASE="memgraph"
MEMGRAPH_USERNAME=""
MEMGRAPH_PASSWORD=""

OPENROUTER_API_KEY="sk-or-v1-replace-me"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="poolside/laguna-s-2.1:free"
EMBEDDING_MODEL="nvidia/nemotron-3-embed-1b:free"

MEMGRAPH_VECTOR_INDEX="moviePlotsNemotron"
EMBEDDING_DIMENSIONS="2048"
# Set to 0 to derive capacity from the number of vectors plus headroom.
MEMGRAPH_VECTOR_CAPACITY="0"
MEMGRAPH_VECTOR_CAPACITY_HEADROOM="1.20"
RETRIEVAL_TOP_K="5"
MIGRATION_BATCH_SIZE="500"
EMBEDDING_BATCH_SIZE="32"
